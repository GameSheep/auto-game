# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.pytest_tmp/

# 敏感信息
.token

# 页面改过的配置（自动生成，删除即回滚到 config.yaml）
config.runtime.yaml

# 运行产物
.coverage
.coverage.*
*.log
*.jsonl
logs/
debug_*.png
# 注意：/templates/*.png **不能**忽略 —— A框/再挑战/技能栏模板是标定资产，
# 缺失会导致检测精度骤降（历史上就踩过：模板没入库 → 现场只有形状启发式）。
# 若模板含敏感画面，可改为加密或单独分发，但不要静默忽略。

# 大体积回放/中间产物（可再生成，不入库）
# 说明：入库的测试素材只有 tests/fixtures/frames（9 帧 12MB）与 assets/samples（8 帧 8MB）；
# 其余原始视频/抽帧/批量帧体积达 1GB+，由 tools/ 下的脚本从视频重新生成。
assets/videos/
assets/replay/
assets/frames/
assets/frames_replay/
assets/batch/
assets/batch_flagged/
assets/uf/
assets/soak/
assets/*_sheet.png
assets/*.mp4
assets/batch_report.json
assets/batch_list.*
assets/replay_*.json
assets/replay_*.csv
assets/hit_check*.png
# 逐帧排查用的可视化（frame_check / monster_sheet / review_offline 生成，可随时重跑）
assets/ms_*.png
assets/monster_sheet*.png
assets/replay_*.png
assets/aframe_candidates.png
assets/aframe_tli_grid.png
assets/a_prompt_grid.png
assets/aframe_template_check.png

# IDE
.idea/
.vscode/

# WorkBuddy 本地记忆（工具数据，不入库）
.workbuddy-ai/

# 项目本地记忆（工具数据，不入库）
.workbuddy/
.scratch/

# 教学编译产物（teach.py 每次重跑都会重写，源头是 lessons/*.md）
profiles/*/teach/

# 自我纠正信号（每次扫日志都重写，不承载状态）
profiles/*/evolve/wanted.json
# 注意：profiles/*/evolve/gen-*/ **要**入库。那不是缓存，是"当前装的是哪一代配方"。
# 回滚靠的就是这些目录 + active 指针；删了它们，设备上学坏之后无处可退。
# 里的 knowledge/ 也要留：那一代的知识快照是行为的一部分，而 lessons/*.md
# 已经改过了，事后无法重建出当时那份。
# 运行时并发锁（PatchStore/世界状态写锁，重启即消，不是数据）
profiles/*/evolve/*.json.lock
profiles/*/groups/*.json.lock
